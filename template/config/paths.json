{
  "untracked_build_output_regexes": [
    "(^|/)(?:target|bin|obj|build|dist|out|__pycache__|\\.venv|venv|node_modules|\\.gradle|\\.pytest_cache|\\.mypy_cache|coverage|_build|\\.build|\\.dart_tool|\\.zig-cache|zig-out)/",
    "\\.py[co]$"
  ],
  "metrics_path": "garda-agent-orchestrator/runtime/metrics.jsonl",
  "runtime_roots": [
    "src/",
    "app/",
    "apps/",
    "backend/",
    "frontend/",
    "web/",
    "api/",
    "services/",
    "packages/",
    "lib/",
    "cmd/",
    "internal/",
    "pkg/",
    "Sources/",
    "crates/"
  ],
  "fast_path_roots": [
    "frontend/",
    "web/",
    "ui/",
    "mobile/",
    "apps/"
  ],
  "fast_path_allowed_regexes": [
    "^.+\\.(ts|tsx|js|jsx|vue|svelte|css|scss|sass|less|html)$",
    "^.+\\.(svg|png|jpg|jpeg|webp|ico)$"
  ],
  "fast_path_sensitive_regexes": [
    "(^|/)(auth|security|payment|checkout|webhook|token|jwt|guard|middleware|service|repository|query|migration|sql|datasource)(/|\\.|$)"
  ],
  "sql_or_migration_regexes": [
    "\\.sql$",
    "(^|/)(db|database|migrations?|schema)(/|$)"
  ],
  "test_refactor_changed_lines_threshold": 50,
  "triggers": {
    "db": [
      "(^|/)(db|database|migrations?|schema)(/|$)",
      "\\.sql$",
      "(Repository|Dao|Specification|Query|Migration)[^/]*\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1)$",
      "(typeorm|prisma|flyway|liquibase|alembic|knex|sequelize|sqlalchemy|hibernate|entityframework|dbcontext|activerecord|doctrine)"
    ],
    "security": [
      "(^|/)(auth|security|oauth|jwt|token|rbac|acl|keycloak|okta|saml|openid|mfa|crypt|encryption|certificate|secret|vault|webhook|payment|checkout|billing)(/|\\.|$)"
    ],
    "refactor": [
      "(Config|Settings|Options|Schema|Contract|Dto|DTO)[^/]*\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1|json|ya?ml|toml|xml)$",
      "(^|/)(config|configs?|schemas?|contracts?)(/|$)",
      "(^|/)[^/]*(config|settings|paths)[^/]*\\.(json|ya?ml|toml|xml)$"
    ],
    "api": [
      "(^|/)(controllers?|routes?|handlers?|endpoints?|graphql)(/|\\.|$)",
      "(Controller|Handler|Endpoint|Router|Routes)[^/]*\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1)$",
      "(Request|Response|Dto|DTO|Contract|Schema)[^/]*\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1)$",
      "(^|/)(openapi|swagger)\\.(ya?ml|json)$",
      "\\.(proto|graphqls?|avsc|thrift)$"
    ],
    "dependency": [
      "(^|/)pom\\.xml$",
      "(^|/)build\\.gradle(\\.kts)?$",
      "(^|/)settings\\.gradle(\\.kts)?$",
      "(^|/)gradle/[^/]*\\.versions\\.toml$",
      "(^|/)gradle\\.lockfile$",
      "(^|/)build\\.sbt$",
      "(^|/)project/(?:plugins|build)\\.sbt$",
      "(^|/)package\\.json$",
      "(^|/)(?:package-lock|npm-shrinkwrap)\\.json$",
      "(^|/)pnpm-(?:lock|workspace)\\.yaml$",
      "(^|/)yarn\\.lock$",
      "(^|/)\\.yarnrc\\.yml$",
      "(^|/)bun\\.lockb?$",
      "(^|/)deno\\.(?:jsonc?|lock)$",
      "(^|/)requirements[^/]*\\.(?:txt|in)$",
      "(^|/)constraints[^/]*\\.txt$",
      "(^|/)(?:poetry|uv|pdm)\\.lock$",
      "(^|/)Pipfile(\\.lock)?$",
      "(^|/)pyproject\\.toml$",
      "(^|/)setup\\.(?:py|cfg)$",
      "(^|/)(?:environment|conda-lock)\\.ya?ml$",
      "(^|/)go\\.(?:mod|sum|work|work\\.sum)$",
      "(^|/)Cargo\\.(?:toml|lock)$",
      "(^|/)rust-toolchain(\\.toml)?$",
      "(^|/)build\\.zig\\.zon$",
      "\\.nimble$",
      "(^|/)shard\\.(?:yml|lock)$",
      "(^|/)composer\\.(?:json|lock)$",
      "(^|/)Gemfile(\\.lock)?$",
      "\\.gemspec$",
      "(^|/)cpanfile(\\.snapshot)?$",
      "\\.rockspec$",
      "\\.(?:csproj|fsproj|vbproj|sln|slnx)$",
      "(^|/)Directory\\.(?:Packages|Build)\\.(?:props|targets)$",
      "(^|/)(?:packages\\.config|packages\\.lock\\.json|global\\.json|nuget\\.config)$",
      "(^|/)Package\\.(?:swift|resolved)$",
      "(^|/)Podfile(\\.lock)?$",
      "(^|/)Cartfile(\\.resolved)?$",
      "(^|/)pubspec\\.(?:yaml|lock)$",
      "(^|/)mix\\.(?:exs|lock)$",
      "(^|/)rebar\\.(?:config|lock)$",
      "\\.cabal$",
      "(^|/)cabal\\.project(\\.freeze)?$",
      "(^|/)stack\\.yaml(\\.lock)?$",
      "\\.opam$",
      "(^|/)dune-project$",
      "(^|/)(?:deps\\.edn|project\\.clj)$",
      "(^|/)elm\\.json$",
      "(^|/)(?:Project|Manifest)\\.toml$",
      "(^|/)renv\\.lock$",
      "(^|/)CMakeLists\\.txt$",
      "(^|/)conanfile\\.(?:txt|py)$",
      "(^|/)vcpkg(?:-configuration)?\\.json$",
      "(^|/)meson\\.build$",
      "(^|/)(?:MODULE\\.bazel|WORKSPACE(?:\\.bazel)?)(\\.lock)?$",
      "(^|/)flake\\.(?:nix|lock)$"
    ],
    "infra": [
      "(^|/)Dockerfile(\\..+)?$",
      "(^|/)docker-compose(\\.[^/]+)?\\.ya?ml$",
      "(^|/)(terraform|infra|infrastructure|helm|k8s|kubernetes)(/|$)",
      "(^|/)\\.github/workflows/"
    ],
    "test": [
      "/src/test/",
      "(^|/)(__tests__|tests?)/",
      "(^|/)src/(?:common|jvm|js|native|android|androidUnit|androidInstrumented|ios|desktop|wasmJs|wasmWasi|integration|functional|unit)Test/",
      "(^|/)[^/]+\\.(?:unit|integration|functional|acceptance|component|e2e)?tests?/",
      "(^|/)e2e/",
      "\\.(spec|test)\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1)$",
      "_test\\.(?:go|py|exs|dart|cc|cpp|cxx|c|lua|cr|nim|zig|jl)$",
      "_unittest\\.(?:cc|cpp|cxx|c)$",
      "_spec\\.(?:rb|lua|cr|exs|js|ts)$",
      "(^|/)test_[^/]+\\.py$",
      "(^|/)t/[^/]+\\.t$",
      "\\.tests\\.ps1$",
      "_SUITE\\.erl$"
    ],
    "test_refactor_structural": [
      "(^|/)(?:__fixtures__|fixtures?|__mocks__|mocks?|helpers?|harness|support|setup|factories|factory|snapshots?)(?:/|\\.|-|_|$)",
      "(?:test|spec)[-_]?(?:helpers?|fixtures?|harness|support|setup|factories?|mocks?)",
      "(?:helpers?|fixtures?|harness|support|setup|factories?|mocks?)[-_]?(?:test|spec)"
    ],
    "performance": [
      "(Cache|Redis|Elasticsearch|Search|Query|Benchmark|Profiling)[^/]*\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1)$",
      "(^|/)(performance|perf|benchmarks?|benches)/"
    ]
  },
  "code_like_regexes": [
    "\\.(?:java|kt|kts|groovy|scala|sc|clj|cljs|cljc|ts|tsx|js|jsx|cjs|mjs|vue|svelte|cs|fs|vb|go|py|rb|php|rs|swift|m|mm|c|cc|cpp|cxx|h|hh|hpp|hxx|ex|exs|erl|hrl|dart|lua|hs|ml|mli|jl|r|nim|zig|cr|pl|pm|sh|bash|ps1|psm1)$"
  ]
}
